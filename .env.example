# Mapbox GL JS token (requerido para el mapa)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Token de autenticación para la API de buses (requerido)
BUS_API_TOKEN=

# Proxy para la API de TransMilenio (opcional, solo si estás fuera de Colombia)
# Si no se configura, la app llama directamente a la API
PROXY_BASE=

# Clave de API de Anthropic para el asistente con IA (/asistente).
# Sin ella el resto de la app funciona y el asistente muestra un aviso de configuración.
ANTHROPIC_API_KEY=

# Modelo del asistente (opcional). Por defecto: claude-opus-5-5
ASSISTANT_MODEL=

# Esfuerzo de razonamiento del asistente (opcional): low | medium | high | xhigh | max.
# Por defecto "low" para respuestas rápidas; súbelo si las respuestas se quedan cortas.
ASSISTANT_EFFORT=

# Mapa base (opcional): mapbox | openfreemap. Si no se define, se usa Mapbox y,
# si Mapbox rechaza las teselas (403), la app cambia sola a OpenFreeMap.
NEXT_PUBLIC_MAP_PROVIDER=
