# Mapbox GL JS token (requerido para el mapa)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Token de autenticación para la API de buses (requerido)
BUS_API_TOKEN=

# Proxy para la API de TransMilenio (opcional, solo si estás fuera de Colombia)
# Si no se configura, la app llama directamente a la API
PROXY_BASE=

# ── Asistente con IA (/asistente) ─────────────────────────────
# Cualquier proveedor con API compatible con el estándar de chat completions
# ("OpenAI-compatible"): Groq, Xiaomi MiMo, OpenRouter, DeepSeek, Together,
# Ollama, LM Studio… Solo necesitas host, clave y un modelo con soporte de tools.
#
# Ejemplos:
#   Groq   AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=openai/gpt-oss-120b
#   MiMo   AI_BASE_URL=https://api.xiaomimimo.com/v1    AI_MODEL=mimo-v2.6-flash
#   Ollama AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=qwen3 (sin clave)
#
# Verifica la conexión y el soporte de tools en: /api/asistente?probar=1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Respaldo (opcional): responde si el principal falla (límite de uso, caída, clave)
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# Parámetros estándar opcionales (solo se envían si los defines)
# AI_REASONING_EFFORT: low | medium | high, para modelos de razonamiento (p. ej. gpt-oss)
AI_REASONING_EFFORT=
AI_MAX_TOKENS=

# Mapa base (opcional): mapbox | openfreemap. Si no se define, se usa Mapbox y,
# si Mapbox rechaza las teselas (403), la app cambia sola a OpenFreeMap.
NEXT_PUBLIC_MAP_PROVIDER=

# Carpeta de los viajes compartidos (enlaces cortos de "Sigue mi viaje") y de los avisos con la
# app cerrada. Por defecto: ./.data
DATA_DIR=

# Avisos con la app cerrada (notificaciones push). Opcional: si no defines las llaves, se generan
# solas y se guardan en DATA_DIR/vapid.json. Si cambian, los teléfonos se suscriben de nuevo.
# Para generarlas a mano: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios push (mailto:… o https://…). Por defecto, la dirección https del sitio
VAPID_SUBJECT=
